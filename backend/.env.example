# ── paste your MongoDB connection string here ──
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/torii?retryWrites=true&w=majority

# Any long random string. Changing it logs the admin out.
JWT_SECRET=change-me-to-a-long-random-string

# The single admin account. Seeded into MongoDB on first boot;
# the password can be changed later from the admin Settings tab.
ADMIN_EMAIL=admin@ncetmail.com
ADMIN_PASSWORD=change-me

PORT=4000
CLIENT_ORIGIN=http://localhost:5180
